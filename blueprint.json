{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Amanah prototype (local)",
		"author": "Lam Thai",
		"description": "Boots WordPress with the Amanah theme mounted from ./theme/amanah and imports the seed content."
	},
	"landingPage": "/",
	"preferredVersions": { "php": "8.3", "wp": "latest" },
	"steps": [
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"WP_ENVIRONMENT_TYPE": "local",
				"WP_DEBUG": true,
				"WP_DEBUG_DISPLAY": true,
				"WP_DEBUG_LOG": false
			}
		},
		{ "step": "activateTheme", "themeFolderName": "amanah" },
		{ "step": "runPHP", "code": "<?php require '/wordpress/wp-load.php'; amanah_seed_run();" }
	]
}
